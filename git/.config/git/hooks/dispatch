#!/bin/sh
# Global git hook dispatcher (core.hooksPath points here).
#
# 1. commit-msg: strip Claude attribution trailers. Non-negotiable — see the
#    "Commit behavior" rule in ~/dotfiles/CLAUDE.md. Nine commits shipped with
#    these on 2026-09-11/12 and had to be rewritten and force-pushed.
# 2. Then hand off to the repo's own .git/hooks/<name> if it has one, so that
#    setting hooksPath globally does not silently disable husky / pre-commit.

name=${0##*/}

if [ "$name" = commit-msg ]; then
	sed -i -E '/^Co-Authored-By: Claude/Id; /^Claude-Session:/Id; /Generated with \[Claude Code\]/Id' "$1"
fi

# --git-dir, NOT --git-path hooks: the latter honours core.hooksPath and would
# re-exec this same script forever.
local_hook="$(git rev-parse --git-dir)/hooks/$name"
[ -x "$local_hook" ] && exec "$local_hook" "$@"
exit 0
