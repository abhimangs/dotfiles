[user]
    name  = abhimangs
    email = abhimangs23@gmail.com

[core]
    editor       = code --wait
    pager        = delta
    # preloadindex parallelises index loading for status/checkout.
    # Note: core.fsmonitor is NOT used here — git's built-in fsmonitor daemon
    # is only implemented on macOS and Windows; on Linux it is a no-op and
    # misleads anyone reading the config into thinking it is active.
    preloadindex = true

[delta]
    navigate     = true
    side-by-side = true
    line-numbers = true
    # Uses the Catppuccin Mocha bat theme already in this repo (bat/themes/).
    # The internal tmTheme name is 'Catppuccin Mocha' (space, not a hyphen).
    syntax-theme = Catppuccin Mocha

[interactive]
    diffFilter = delta --color-only

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true

[fetch]
    # Auto-prune remote-tracking branches that no longer exist on the remote.
    prune = true

[pull]
    rebase = false

[merge]
    conflictStyle = diff3

[rerere]
    enabled = true

[alias]
    st      = status
    co      = checkout
    sw      = switch
    br      = branch
    lg      = log --oneline --graph --decorate --all
    wdiff   = diff --word-diff
    undo    = reset HEAD~1 --mixed
    unstage = restore --staged
    # Safe force-push: fails if the remote has diverged since your last fetch
    pushf   = push --force-with-lease

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
